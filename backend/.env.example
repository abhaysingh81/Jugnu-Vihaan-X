GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to omniroute or gemini. If blank, Jugnu prefers Gemini when a key is set.
JUGNU_AI_PROVIDER=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=auto/best-free
OMNIROUTE_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Live assessments. Set the same random JUGNU_AGENT_TOKEN in the Maritime agent secrets.
MARITIME_AGENT_ID=
MARITIME_API_KEY=
JUGNU_AGENT_TOKEN=

# Production settings. Use a private backend and HTTPS at the public frontend.
DATABASE_URL=sqlite:///jugnu.db
JUGNU_SECURE_COOKIES=0

# Optional trusted-contact SMS provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Demo only. Use a Voice-capable non-Indian caller ID to call the opted-in Indian contact.
JUGNU_DEMO_EMAIL=
JUGNU_DEMO_CONTACT=
TWILIO_VOICE_FROM=
# Use trial for an account that only accepts Twilio's hosted sample voice template.
TWILIO_VOICE_MODE=standard
